  "pass_criteria": {
    "LITTER": "confirmed_violations >= 1 AND Event row with non-null actor/object UIDs AND ForensicAssetPanel shows matching person+waste",
    "NO_EVENT": "confirmed_violations == 0 AND events_count == 0",
    "BIN": "no VIOLATION_CONFIRMED OR rejection BIN_ZONE_DEPOSIT / NO_CONFIDENT_EVENT",
    "PICKUP": "PICKED_BACK_UP rejection or zero confirmed",
    "MULTI_PERSON": "confirmed actor UID matches labeled litterer only"
  },
  "metrics": {
    "frozen_set": "evaluation/frozen_test_set.v1.json",
    "runner": "evaluation/run_frozen_eval.py",
    "formulas": {
      "precision": "TP / (TP + FP)",
      "recall": "TP / (TP + FN)",
      "f1": "2 * precision * recall / (precision + recall)",
      "temporal_delta_t_sec": 3.0,
      "temporal_t_max_sec": 10.0
    }
  }
