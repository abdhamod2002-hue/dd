<file path="docker-compose.yml">
services:
  postgres:
    image: postgres:16-alpine
    container_name: littering-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: litter
      POSTGRES_PASSWORD: litter
      POSTGRES_DB: littering
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U litter -d littering"]
      interval: 5s
      timeout: 5s
      retries: 20

  backend:
    build:
      context: .
      dockerfile: backend/Dockerfile
    container_name: littering-backend
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql://litter:litter@postgres:5432/littering
      PYTHONPATH: /app
      TFHUB_CACHE_DIR: /app/models/movenet
      ANALYSIS_FPS: "8"
    ports:
      - "8000:8000"
    volumes:
      # Real project source + models (host) so the running image always
      # reflects the local repo. Bind mount beats COPY for dev.
      - ./:/app
      # Persistent evidence/uploads out of the live container.
      - evidence_store:/app/evidence_store
      - uploaded_videos:/app/backend/uploaded_videos
      # Real data location: D:\W -> /data/W.
      - D:/W:/data/W:ro
    command: uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 1

  dashboard:
    image: node:20-alpine
    container_name: littering-dashboard
    restart: unless-stopped
    working_dir: /dashboard
    depends_on:
      - backend
    environment:
      VITE_API_BASE: http://backend:8000/api
      VITE_PROXY_TARGET: http://backend:8000
    ports:
      - "5173:5173"
    volumes:
      - ./dashboard:/dashboard
      - /dashboard/node_modules
    command: sh -c "if [ ! -x node_modules/.bin/vite ]; then npm install --no-audit --no-fund; fi; npm run dev -- --host 0.0.0.0 --port 5173"

volumes:
  pgdata:
  evidence_store:
  uploaded_videos:
</file>

