# ByteTrack configuration optimized for detecting low-contrast / small objects (e.g., trash bags)
# Ref: GitHub Issue #1320 - tuning track activation & second pass thresholds

tracker_type: bytetrack

# High confidence threshold for first association pass (lowered from default 0.5/0.6 to capture small objects)
track_high_thresh: 0.25

# Low confidence threshold for second association pass (allows tracking low-confidence detections down to 0.1)
track_low_thresh: 0.1

# Threshold for activating a new track
new_track_thresh: 0.25

# Number of frames to keep lost tracks before deleting
track_buffer: 30

# IoU matching threshold for association
match_thresh: 0.8

# Fuse detection score with IoU during matching
fuse_score: True

# Minimum consecutive frames before track is confirmed (prevents ID skipping / jitter)
minimum_consecutive_frames: 2
